# Database (Local SQLite by default; switch provider & URL for PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# 32-byte hex or strong secret for AES-256-GCM encryption of integration credentials
# Generate in production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET="replace-with-a-64-char-hex-secret-in-production"

# Public app origin (used for CSRF origin check & OAuth callbacks in production)
APP_ORIGIN="http://localhost:3000"

# Optional Google OAuth credentials (if configured, enables "Continue with Google")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Gemini API key (if configured, enhances Cielora AI Assistant responses)
GEMINI_API_KEY=""
